+    if (!valid_object( dimensionsJson ) || !valid_object( measurementsJson )) return E_INVALIDARG;
+    if (!(xuid = xuser_get_xuid( user ))) return E_INVALIDARG;
+    return queue_event( xuid, serviceConfigId, playSessionId, eventName, dimensionsJson, measurementsJson );
 }
 
