 static HRESULT files_cloud_download( struct XGameSaveProvider *, const char *, const char *, const char * );
+
+/* iOdus: a save conflict is recorded in <root>\sync-conflict, so that the
+ * launcher can ask the player which save to keep (XODUS_SAVE_SYNC). */
+static void write_conflict( struct XGameSaveProvider *provider, const char *name, UINT64 local, const char *remote )
+{
+    char path[2048], text[512];
+    int len;
+    snprintf( path, sizeof(path), "%s\\sync-conflict", provider->root );
+    len = snprintf( text, sizeof(text), "container %s\nlocal %I64u\nremote %s\n", name, local, remote ? remote : "-" );
+    if (len > 0 && len < sizeof(text)) write_file( path, text, len );
+}
 
+static void clear_conflict( struct XGameSaveProvider *provider )
+{
+    char path[2048];
+    snprintf( path, sizeof(path), "%s\\sync-conflict", provider->root );
+    DeleteFileA( path );
+}
