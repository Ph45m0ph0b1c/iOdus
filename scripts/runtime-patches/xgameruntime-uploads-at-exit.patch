+
+/* iOdus: the open providers with cloud saves. Many games write a save when
+ * the player quits, and then end the process at once. The upload worker
+ * then stops in the middle of the upload. XGameRuntimeUninitialize is the
+ * last safe point: it drains the uploads of all open providers. */
+static SRWLOCK open_lock = SRWLOCK_INIT;
+static struct XGameSaveProvider *open_providers;
+
+static HRESULT WINAPI drain_open_providers( void *context )
+{
+    struct XGameSaveProvider *provider;
+
+    AcquireSRWLockExclusive( &open_lock );
+    for (provider = open_providers; provider; provider = provider->next_open)
+    {
+        drain_uploads( provider );
+        cloud_unlock( provider, FALSE );
+    }
+    ReleaseSRWLockExclusive( &open_lock );
+    return S_OK;
+}
+
+static void add_open_provider( struct XGameSaveProvider *provider )
+{
+    HRESULT hr = NexusRegisterCloudShutdown( drain_open_providers, NULL );
+    if (FAILED(hr)) WARN( "cannot register the save drain at shutdown, hr %#lx.\n", hr );
+    AcquireSRWLockExclusive( &open_lock );
+    provider->next_open = open_providers;
+    open_providers = provider;
+    ReleaseSRWLockExclusive( &open_lock );
+}
+
+static void remove_open_provider( struct XGameSaveProvider *provider )
+{
+    struct XGameSaveProvider **link;
+
+    /* Waits for a drain that runs now, so that the provider stays valid. */
+    AcquireSRWLockExclusive( &open_lock );
+    for (link = &open_providers; *link; link = &(*link)->next_open)
+    {
+        if (*link == provider)
+        {
+            *link = provider->next_open;
+            break;
+        }
+    }
+    ReleaseSRWLockExclusive( &open_lock );
+}
+
+static void close_provider( struct XGameSaveProvider *provider )
+{
+    if (!provider) return;
+    remove_open_provider( provider );
+    if (provider->uploads_ready)
+    {
+        drain_uploads( provider );
         CloseHandle( provider->upload_event );
         DeleteCriticalSection( &provider->cloud_cs );
     }
