 IXGameSaveImpl *x_game_save_impl = (IXGameSaveImpl *)&x_game_save.IXGameSaveImpl3_iface;
+
+/* iOdus: rundll32 xgameruntime.dll,XodusSyncSaves <Windows path of MicrosoftGame.config>
+ *
+ * iOdus starts this helper after a game process ends, when a save of the game
+ * is still dirty: the game wrote it just before it ended, and the upload did
+ * not finish. The helper signs in silently and opens the save provider of the
+ * title. That runs the same sync as a game start: a dirty save uploads when
+ * the cloud did not change, and a changed cloud gives the sync-conflict file.
+ * Then the provider closes, which waits for the uploads.
+ *
+ * The helper never sets the title presence: it is not a game session.
+ * It prints one line "iodus-savesync: ..." and ends with exit code 0 when the
+ * cloud sync ran, 2 when cloud saves were off (conflict or error), else 1. */
+void CALLBACK XodusSyncSavesW( HWND hwnd, HINSTANCE instance, WCHAR *cmdline, int show )
+{
+    struct XGameSaveProvider *provider = NULL;
+    IXThreadingImpl *threads = NULL;
+    XAsyncBlock async = { 0 };
+    XUserHandle user = NULL;
+    char path[MAX_PATH * 3], scid[64];
+    const WCHAR *start = cmdline, *end;
+    UINT32 uploaded = 0, downloaded = 0;
+    BOOL cloud = FALSE;
+    HRESULT hr;
+    int len;
+
+    SetEnvironmentVariableA( "IODUS_PRESENCE", "0" );
+    if (!start) start = L"";
+    while (*start == ' ' || *start == '"') start++;
+    end = start + lstrlenW( start );
+    while (end > start && (end[-1] == ' ' || end[-1] == '"' || end[-1] == '\r' || end[-1] == '\n')) end--;
+    len = end > start ? WideCharToMultiByte( CP_ACP, 0, start, end - start, path, sizeof(path) - 1, NULL, NULL ) : 0;
+    if (len <= 0) { hr = E_INVALIDARG; goto done; }
+    path[len] = 0;
+
+    if (FAILED(hr = xgameruntime_initialize_config( path ))) goto done;
+    /* Without the package identity, the provider has no cloud saves. */
+    if (!packageFamilyName || !titleId) { hr = E_GAMERUNTIME_GAMECONFIG_BAD_FORMAT; goto done; }
+    snprintf( scid, sizeof(scid), "00000000-0000-0000-0000-0000%08x", titleId );
+
+    if (FAILED(hr = QueryApiImpl( &CLSID_XThreadingImpl, &IID_IXThreadingImpl, (void **)&threads ))) goto done;
+    if (FAILED(hr = IXUserImpl_XUserAddAsync( x_user_impl, XUserAddOptions_AddDefaultUserSilently, &async )) ||
+        FAILED(hr = IXThreadingImpl_XAsyncGetStatus( threads, &async, TRUE )) ||
+        FAILED(hr = IXUserImpl_XUserAddResult( x_user_impl, &async, &user ))) goto done;
+
+    if (FAILED(hr = initialize_provider( user, scid, &provider ))) goto done;
+    cloud = provider->cloud;
+    downloaded = provider->downloaded;
+    uploaded = provider->uploaded;
+    close_provider( provider );
+
+done:
+    MESSAGE( "iodus-savesync: hr %#lx cloud %d downloaded %u uploaded %u\n", hr, cloud, downloaded, uploaded );
+    if (user) IXUserImpl_XUserCloseHandle( x_user_impl, user );
+    if (threads) IXThreadingImpl_Release( threads );
+    ExitProcess( FAILED(hr) ? 1 : cloud ? 0 : 2 );
+}
