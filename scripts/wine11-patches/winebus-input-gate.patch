+/* iOdus input gate. While the file C:\.iodus-input-gate exists (the iOdus
+ * overlay is open), the game gets one report with no buttons pressed and then
+ * no input. The device state stays current, so the real state goes to the game
+ * again when the file is gone. The services have no WINEPREFIX in their Unix
+ * environment, so ntdll gives the Unix path of C:\. */
+static BOOL input_gated;
+
+static char input_gate_path[PATH_MAX];
+static UINT gate_event = -1;
+
+/* Called once on a Wine thread (sdl_bus_init): ntdll needs a Wine thread. */
+static void init_input_gate_path(void)
+{
+    static const WCHAR drive_c[] = {'\\','?','?','\\','C',':','\\',0};
+    char *unix_name;
+
+    if (!ntdll_get_unix_file_name(drive_c, &unix_name, FILE_OPEN))
+    {
+        snprintf(input_gate_path, sizeof(input_gate_path), "%s/.iodus-input-gate", unix_name);
+        free(unix_name);
+    }
+    TRACE("iOdus input gate file %s\n", debugstr_a(input_gate_path));
+}
+
+static BOOL input_gate_file_exists(void)
+{
+    return input_gate_path[0] && !access(input_gate_path, F_OK);
+}
+
+static void *input_gate_watch(void *arg);
+
+static void queue_state_report(struct unix_device *iface)
+{
+    struct hid_device_state *state = &iface->hid_device_state;
+    if (input_gated) return;
+    bus_event_queue_input_report(&event_queue, iface, state->report_buf, state->report_len);
+}
+
+/* One report with all buttons up, the axes at 0 (centered sticks, released
+ * triggers), and the hat switches centered. The real state stays unchanged. */
+static void queue_neutral_report(struct unix_device *iface)
+{
+    struct hid_device_state *state = &iface->hid_device_state;
+    BYTE *saved;
+    ULONG i;
+
+    if (!(saved = malloc(state->report_len))) return;
+    memcpy(saved, state->report_buf, state->report_len);
+    for (i = 0; i < state->button_count; i++) hid_device_set_button(iface, i, FALSE);
+    for (i = 0; i < state->abs_axis_count; i++) hid_device_set_abs_axis(iface, i, 0);
+    for (i = 0; i < state->hatswitch_count; i++)
+    {
+        hid_device_set_hatswitch_x(iface, i, 0);
+        hid_device_set_hatswitch_y(iface, i, 0);
+    }
+    bus_event_queue_input_report(&event_queue, iface, state->report_buf, state->report_len);
+    memcpy(state->report_buf, saved, state->report_len);
+    free(saved);
+}
