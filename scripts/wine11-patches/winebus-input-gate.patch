+
+/* SDL_WaitEventTimeout does not always return after its timeout, so the bus
+ * loop cannot check the file itself. This thread checks it every 20 ms and
+ * wakes the loop with gate_event when it changes. It only calls access(). */
+static void *input_gate_watch(void *arg)
+{
+    BOOL last = FALSE, now;
+    SDL_Event event;
+
+    for (;;)
+    {
+        usleep(20000);
+        if ((now = input_gate_file_exists()) == last) continue;
+        last = now;
+        memset(&event, 0, sizeof(event));
+        event.type = gate_event;
+        pSDL_PushEvent(&event);
+    }
+    return NULL;
 }
 
+static void update_input_gate(void)
+{
+    struct sdl_device *impl;
+    BOOL gated;
+
+    if ((gated = input_gate_file_exists()) == input_gated) return;
+
+    pthread_mutex_lock(&sdl_cs);
+    input_gated = gated;
+    TRACE("iOdus input gate %s\n", gated ? "on" : "off");
+    LIST_FOR_EACH_ENTRY(impl, &device_list, struct sdl_device, unix_device.entry)
+    {
+        if (gated) queue_neutral_report(&impl->unix_device);
+        else queue_state_report(&impl->unix_device);
+    }
+    pthread_mutex_unlock(&sdl_cs);
+}
+
